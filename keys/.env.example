# ── Provider selection ────────────────────────────────────────────────────────
# Set this to the provider you want to use.
# Supported values: openai | azure | anthropic | ollama
LLM_PROVIDER=openai

# ── Azure OpenAI ──────────────────────────────────────────────────────────────
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_MODEL_NAME=gpt-4.1-mini

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-4o

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_NAME=claude-3-5-haiku-20241022

# ── Ollama (local — no API key required) ─────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL_NAME=qwen3:8b

# ── Ultravox (voice agent example only) ──────────────────────────────────────
ULTRAVOX_API_KEY=
AUTO_OPEN_BROWSER=true
APP_URL=http://127.0.0.1:5000
